# Neon Postgres connection string (the app uses Neon's HTTP driver, so this
# must be a real Neon endpoint, not a local Postgres instance). Get one with
# `neon checkout dev --create` or `neon env pull`, or from console.neon.tech.
DATABASE_URL=postgresql://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Used once by `npm run seed` to create your login. Safe to remove after first run.
ADMIN_EMAIL=
ADMIN_PASSWORD=
