# Postgres connection string. For local dev, point at a local Postgres instance.
# For production, use your Neon connection string (console.neon.tech).
DATABASE_URL=postgres://user:password@localhost:5432/ledgervault_dev

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Used once by `npm run seed` to create your login. Safe to remove after first run.
ADMIN_EMAIL=
ADMIN_PASSWORD=
